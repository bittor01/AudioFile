{
  "name": "app",
  "version": "1.0.0",
  "description": "An app for processing audio files.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "cleanup": "node cleanup.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.example.audiofiletools",
    "productName": "Audio File Tools",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "index.html",
      "renderer.js",
      "style.css",
      "preload.js",
      "example/linktowav.ps1"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bittor01/AudoFile.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/bittor01/AudoFile/issues"
  },
  "homepage": "https://github.com/bittor01/AudoFile#readme",
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "get-windows-shortcut-properties": "^1.3.0"
  }
}